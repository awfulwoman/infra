# code: language=ansible
name: "{{ composition_name }}"
services:
  hermes:
    container_name: "{{ composition_name }}"
    image: "{{ composition_hermes_jarvis_image }}"
    restart: unless-stopped
    env_file: .environment_vars
    # Without this the image's default entrypoint starts the interactive TUI,
    # which exits immediately on a non-tty stdin and leaves the container
    # restart-looping. The dashboard is not started here - it is a separate s6
    # slot that /init brings up when HERMES_DASHBOARD is set.
    command: ["gateway", "run"]
    # s6 needs ~15s to bring the gateway and dashboard down; Docker's default
    # is 10, so a plain `docker stop` or `compose down` SIGKILLs it mid-write.
    # The "Restart Hermes" handler does NOT get this - community.docker sends
    # its own stop_timeout and ignores the container's StopTimeout - so that
    # value is set separately in handlers/main.yaml. Keep the two in step.
    stop_grace_period: 60s
    volumes:
      # Upstream mounts ~/.hermes here. Instead the agent's whole state -
      # config.yaml, .env, memories, skills, cron, sessions, logs - lives on
      # the compositions dataset instead, so ZFS snapshots cover it.
      - "{{ composition_config }}/data:/opt/data"
      - /etc/localtime:/etc/localtime:ro
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.{{ composition_name }}.rule=Host(`{{ composition_dns_subdomains[0] }}.{{ domainname_infra }}`)"
      - "traefik.http.routers.{{ composition_name }}.tls=true"
      - "traefik.http.routers.{{ composition_name }}.service={{ composition_name }}"
{% if reverseproxy_use_letsencrypt and not reverseproxy_wildcard_cert %}
      - "traefik.http.routers.{{ composition_name }}.tls.certresolver=letsencrypt"
{% endif %}
      - "traefik.http.services.{{ composition_name }}.loadbalancer.server.port={{ composition_hermes_jarvis_dashboard_port }}"
{% if composition_hermes_jarvis_api_server %}
      - "traefik.http.routers.{{ composition_name }}-api.rule=Host(`{{ composition_dns_subdomains[1] }}.{{ domainname_infra }}`)"
      - "traefik.http.routers.{{ composition_name }}-api.tls=true"
{% if reverseproxy_use_letsencrypt and not reverseproxy_wildcard_cert %}
      - "traefik.http.routers.{{ composition_name }}-api.tls.certresolver=letsencrypt"
{% endif %}
      - "traefik.http.routers.{{ composition_name }}-api.service={{ composition_name }}-api"
      - "traefik.http.services.{{ composition_name }}-api.loadbalancer.server.port={{ composition_hermes_jarvis_api_server_port }}"
{% endif %}
    networks:
      - "{{ default_docker_network }}"
{% if composition_hermes_jarvis_dashboard %}
    # Debian trixie image: bash is present, so probe the socket rather than
    # fetching a URL. Every dashboard path answers 401 until you log in, so an
    # HTTP check would have to treat an auth failure as healthy.
    # start_period is generous: s6 runs the cont-init.d scripts (chown of
    # /opt/data, profile reconcile) before the dashboard slot comes up.
    healthcheck:
      test: ["CMD-SHELL", "bash -c 'echo > /dev/tcp/localhost/{{ composition_hermes_jarvis_dashboard_port }}'"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 120s
{% endif %}

networks:
  "{{ default_docker_network }}":
    external: true
