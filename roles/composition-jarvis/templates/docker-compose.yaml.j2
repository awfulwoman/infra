# code: language=ansible
name: "{{ composition_name }}"
services:
  # Service key stays "chives" even though this role is composition-jarvis -
  # Docker Compose matches an existing container to a service by this key,
  # not just container_name:. Renaming it to "jarvis" here once caused a real
  # outage on the sibling composition-nabu role (identical shape): Compose no
  # longer recognised the already-running container as belonging to this
  # service, tried to create a second one with the same container_name, and
  # the resulting conflict took the running container down without bringing
  # a replacement up. Never rename this.
  chives:
    container_name: "{{ composition_name }}"
    image: ghcr.io/awfulwoman/chives:latest
    restart: unless-stopped
    env_file: .environment_vars
    ports:
      - "{{ composition_jarvis_openai_port }}:8080"
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.{{ composition_name }}.rule=Host(`{{ composition_name }}.{{ domainname_infra }}`)"
      - "traefik.http.routers.{{ composition_name }}.tls=true"
      - "traefik.http.routers.{{ composition_name }}.tls.certresolver=letsencrypt"
      - "traefik.http.services.{{ composition_name }}.loadbalancer.server.port=8080"
    volumes:
      - "{{ composition_config }}/state:/app/state"
      - "{{ composition_config }}/profile:/app/profile"
      - "{{ composition_config }}/config.yaml:/app/config.yaml:ro"
    networks:
      - "{{ default_docker_network }}"
    healthcheck:
      test: ["CMD-SHELL", "bash -c 'echo > /dev/tcp/localhost/8080'"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 60s

networks:
  "{{ default_docker_network }}":
    external: true
