TZ="Europe/Berlin"

# Core
# See https://raw.githubusercontent.com/firefly-iii/firefly-iii/main/.env.example
STATIC_CRON_TOKEN="{{ vault_firefly_cron_token }}" # MUST be 32 characters long
APP_KEY="{{ vault_firefly_app_key }}"
APP_URL="{{ firefly_app_url }}"
APP_LOG_LEVEL={{ firefly_log_level }}
DB_HOST="firefly_iii_db"
DB_CONNECTION=mysql
DB_PORT=3306
DB_DATABASE=firefly
DB_USERNAME=firefly
DB_PASSWORD="{{ vault_firefly_db_password }}"
TRUSTED_PROXIES=**

# Mail
MAIL_MAILER={{ firefly_mail_mailer }}
MAIL_FROM="{{ firefly_mail_from }}"
SITE_OWNER="{{ firefly_site_owner }}"
