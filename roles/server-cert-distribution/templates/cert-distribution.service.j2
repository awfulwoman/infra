[Unit]
Description=Serve the internal wildcard cert bundle to infra hosts over Tailscale
Documentation=roles/server-cert-distribution/README.md
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 -m http.server {{ server_cert_distribution_port }} --bind {{ server_cert_distribution_bind_address }} --directory {{ server_cert_distribution_source_dir }}
Restart=on-failure
RestartSec=5
User={{ ansible_user }}
Group={{ ansible_user }}
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
