# code: language=ansible-jinja
name: "{{ composition_name }}"
services:
  indiekit:
    container_name: indiekit
    image: "{{ composition_indiekit_image }}"
    build:
      context: "{{ composition_indiekit_build_context }}"
      dockerfile: docker/Dockerfile
    restart: unless-stopped
    env_file: .environment_vars
    volumes:
      - "{{ composition_config }}/indiekit.config.js:/app/indiekit.config.js:ro"
    depends_on:
      mongo:
        condition: service_healthy
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.indiekit.rule=Host(`{{ composition_indiekit_hostname }}`)"
      - "traefik.http.routers.indiekit.tls=true"
{% if reverseproxy_use_letsencrypt and not reverseproxy_wildcard_cert %}
      - "traefik.http.routers.indiekit.tls.certresolver=letsencrypt"
{% endif %}
      # The password is set out of band (hash vaulted), so the web form that
      # sets it must never be reachable. noop@internal answers 418.
      - "traefik.http.routers.indiekit-block.rule=Host(`{{ composition_indiekit_hostname }}`) && PathPrefix(`/auth/new-password`)"
      - "traefik.http.routers.indiekit-block.priority=1000"
      - "traefik.http.routers.indiekit-block.tls=true"
      - "traefik.http.routers.indiekit-block.service=noop@internal"
      - "traefik.http.services.indiekit.loadbalancer.server.port=3000"
    networks:
      - "{{ default_docker_network }}"
      - backend
    # Image base is unknown, so probe with node rather than bash or wget.
    healthcheck:
      test: ["CMD", "node", "-e", "require('net').connect(3000,'127.0.0.1').on('connect',()=>process.exit(0)).on('error',()=>process.exit(1))"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s

  mongo:
    container_name: indiekit-mongo
    image: "{{ composition_indiekit_mongo_image }}"
    restart: unless-stopped
    volumes:
      - "{{ composition_config }}/mongo:/data/db"
    networks:
      - backend
    healthcheck:
      test: ["CMD", "mongosh", "--quiet", "--eval", "db.adminCommand('ping')"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 20s

networks:
  "{{ default_docker_network }}":
    external: true
  # Mongo has no auth, so keep it off the shared network.
  backend:
    internal: true
