<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>{{ system_apple_reminders_server_watchdog_plist_label }}</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>{{ system_apple_reminders_server_state_dir }}/reminders-watchdog.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>{{ system_apple_reminders_server_repo_dir }}</string>
    <key>RunAtLoad</key>
    <true/>
    <key>StartInterval</key>
    <integer>{{ system_apple_reminders_server_watchdog_interval }}</integer>
    <key>StandardOutPath</key>
    <string>{{ system_apple_reminders_server_repo_dir }}/logs/watchdog.out</string>
    <key>StandardErrorPath</key>
    <string>{{ system_apple_reminders_server_repo_dir }}/logs/watchdog.err</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
    </dict>
</dict>
</plist>
