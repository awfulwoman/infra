# Syslog ingress for the whole fleet. Container logs are NOT collected here -
# each host ships its own via composition-logtide-agent, storage included.
[SERVICE]
    Flush        5
    Daemon       Off
    Log_Level    warn
    Parsers_File /fluent-bit/etc/parsers.conf

[INPUT]
    Name        syslog
    Parser      syslog-rfc3164
    Listen      0.0.0.0
    Port        514
    Mode        udp
    Tag         syslog.udp

[INPUT]
    Name        syslog
    Parser      syslog-rfc3164
    Listen      0.0.0.0
    Port        514
    Mode        tcp
    Tag         syslog.tcp

[FILTER]
    Name                lua
    Match               syslog.*
    script              /fluent-bit/etc/map_syslog_level.lua
    call                map_syslog_level

[OUTPUT]
    Name                http
    Match               syslog.*
    Host                ${LOGTIDE_API_HOST}
    Port                {{ composition_logtide_backend_port }}
    URI                 /api/v1/ingest/single
    Format              json_lines
    Header              X-API-Key ${FLUENT_BIT_API_KEY}
    Header              Content-Type application/json
    Json_date_key       time
    Json_date_format    iso8601
    Retry_Limit         3
    tls                 Off
