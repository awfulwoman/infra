# Logtide monitor definitions
#
# Source of truth for uptime monitors. Apply changes via:
#   Logtide UI > Monitoring > (create/edit)
#
# Field names match the Logtide API (camelCase). A future sync script can POST/PUT
# these directly to POST /api/v1/monitors once the API supports key-scoped auth.
#
# Types:
#   http         - HTTP/HTTPS endpoint check
#   tcp          - TCP port reachability
#   heartbeat    - expects periodic pings (for cron jobs / backups)
#   log_heartbeat - checks that a service name appears in logs within the grace period

monitors:

  # ---------------------------------------------------------------------------
  # Infrastructure
  # ---------------------------------------------------------------------------

  - name: Logtide
    type: http
    target: https://logtide.{{ domainname_infra }}
    intervalSeconds: 60
    timeoutSeconds: 10
    failureThreshold: 3
    severity: critical
    httpConfig:
      expectedStatus: 200

  - name: Homepage
    type: http
    target: https://home.{{ domainname_infra }}
    intervalSeconds: 60
    timeoutSeconds: 10
    failureThreshold: 3
    severity: high
    httpConfig:
      expectedStatus: 200

  - name: Uptime Kuma
    type: http
    target: https://uptimekuma.{{ domainname_infra }}
    intervalSeconds: 60
    timeoutSeconds: 10
    failureThreshold: 3
    severity: medium
    httpConfig:
      expectedStatus: 200

  # ---------------------------------------------------------------------------
  # Home automation
  # ---------------------------------------------------------------------------

  - name: Home Assistant
    type: http
    target: https://homeassistant.{{ domainname_infra }}
    intervalSeconds: 60
    timeoutSeconds: 10
    failureThreshold: 2
    severity: critical
    httpConfig:
      expectedStatus: 200

  # ---------------------------------------------------------------------------
  # Code & productivity
  # ---------------------------------------------------------------------------

  - name: Gitea
    type: http
