  # ---------------------------------------------------------------------------
  # Backups (heartbeat — ping after each successful run)
  #
  # To wire up: add a curl step to each backup script/systemd unit:
  #   curl -s -X POST https://logtide.{{ domainname_infra }}/api/v1/monitors/<id>/heartbeat \
  #     -H "X-API-Key: <write-key>"
  # ---------------------------------------------------------------------------

  - name: ZFS Backup — storage → backups
    type: heartbeat
    gracePeriodSeconds: 90000  # 25h — job runs daily
    severity: critical

  - name: ZFS Backup — offsite
    type: heartbeat
    gracePeriodSeconds: 90000
    severity: high
