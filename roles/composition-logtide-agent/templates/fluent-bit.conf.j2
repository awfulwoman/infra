[SERVICE]
    Flush        {{ composition_logtide_agent_flush_interval }}
    Daemon       Off
    Log_Level    {{ composition_logtide_agent_log_level }}
    Parsers_File /fluent-bit/etc/parsers.conf

[INPUT]
    Name              tail
    Path              {{ composition_logtide_agent_docker_log_path }}/*/*.log
    Parser            docker
    Tag               docker.*
    Refresh_Interval  5
    Mem_Buf_Limit     5MB
    Skip_Long_Lines   On
    Path_Key          filepath
    DB                /var/lib/logtide-agent/docker.db

[FILTER]
    Name                parser
    Match               docker.*
    Key_Name            log
    Parser              docker_json
    Reserve_Data        On
    Preserve_Key        On

[FILTER]
    Name                lua
    Match               docker.*
    script              /fluent-bit/etc/extract_container_id.lua
    call                extract_container_id

[FILTER]
    Name                grep
    Match               docker.*
    Exclude             container_name {{ composition_logtide_agent_exclude_pattern }}

# hostname is what keeps same-named containers on different hosts apart -
# traefik, watchtower and zfs-api all run on more than one host, and service
# is just the container name.
[FILTER]
    Name                modify
    Match               docker.*
    Add                 level info
    Add                 hostname {{ host_name }}
    Rename              log message
    Copy                container_name service

[FILTER]
    Name                record_modifier
    Match               docker.*
    Remove_key          stream
    Remove_key          filepath
    Remove_key          container_name

[OUTPUT]
    Name                http
    Match               docker.*
    Host                ${LOGTIDE_API_HOST}
    Port                {{ composition_logtide_agent_api_port }}
    URI                 /api/v1/ingest/single
    Format              json_lines
    Header              X-API-Key ${FLUENT_BIT_API_KEY}
    Header              Content-Type application/json
    Json_date_key       time
    Json_date_format    iso8601
    Retry_Limit         3
    tls                 On
    tls.verify          On
