# code: language=ansible
name: "{{ composition_name }}"
services:
  web:
    image: nginx
    container_name: awfulwoman
    restart: unless-stopped
    env_file: .environment_vars
    environment:
      - NGINX_HOST="{{ domainname_personal }}"
      - NGINX_PORT=80
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.beta.rule=Host(`{{ domainname_personal }}`) || Host(`{{ vault_domainname_wc }}`) || Host(`{{ vault_domainname_se }}`)"
      - "traefik.http.routers.beta.tls=true"
      # No certresolver: the certificates for these public names are issued
      # on bertha and handed to this host (reverseproxy_extra_cert_dirs), so
      # Traefik picks the matching one by SNI.
      - "traefik.http.services.beta.loadbalancer.server.port=80"
      # www redirects to the apex (the wildcard certificate already covers it).
      - "traefik.http.routers.beta-www.rule=Host(`www.{{ domainname_personal }}`)"
      - "traefik.http.routers.beta-www.tls=true"
      - "traefik.http.routers.beta-www.middlewares=beta-www-redirect"
      - "traefik.http.routers.beta-www.service=noop@internal"
      - "traefik.http.middlewares.beta-www-redirect.redirectregex.regex=^https://www[.]{{ domainname_personal | replace('.', '[.]') }}/(.*)"
      - "traefik.http.middlewares.beta-www-redirect.redirectregex.replacement=https://{{ domainname_personal }}/$${1}"
      - "traefik.http.middlewares.beta-www-redirect.redirectregex.permanent=true"
    volumes:
      - "{{ awfulwoman_path }}:/usr/share/nginx/html"
      - "{{ composition_config }}/nginx.conf:/etc/nginx/nginx.conf"
      - "{{ composition_config }}/default.conf:/etc/nginx/conf.d/default.conf:ro"
      - /etc/localtime:/etc/localtime:ro
    networks:
      - "{{ default_docker_network }}"

networks:
  "{{ default_docker_network }}":
    external: true
