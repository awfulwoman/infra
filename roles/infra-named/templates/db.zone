#jinja2: lstrip_blocks:True
; Forward zone for the "{{ bind_zone_address_var }}" address of each host.
; With split-horizon on (bind_views_enabled) this file is rendered once per
; view; only the A records below differ between them, never the CNAMEs.
$TTL       {{ bind_default_ttl }}
$ORIGIN    {{ bind_domain }}.
@                                        IN      SOA       {{ bind_records_nameservers[0].name }}.{{ bind_domain }}. admin.{{ domainname_infra }}. (
  1234567890 ; Serial
  604800 ; Refresh
  86400 ; Retry
  2419200 ; Expire
  604800 ; Negative Cache TTL
)

; Nameservers - from config
{% if bind_records_nameservers is defined %}
  {% for record in bind_records_nameservers %}
                                         IN      NS        {{ record.name }}.{{ bind_domain }}.
  {% endfor %}
{% endif %}

; A records - from config
{# A record may give either a literal `ip`, or a `host` naming an inventory host
   to take the address from — the latter follows the view, so the nameserver and
   apex glue point at an address the asking client can route to. #}
{% if bind_records_nameservers is defined %}
  {% for record in bind_records_nameservers %}
    {% if record.host is defined %}
      {% set record_address = hostvars[record.host][bind_zone_address_var] | default('') %}
    {% else %}
      {% set record_address = record.ip | default('') %}
    {% endif %}
    {% if record_address %}
      {{- '%-40s' | format(record.name) }}{% if record.ttl is defined %} {{ record.ttl }}{% endif %} IN      A         {{ record_address }}
    {% endif %}
  {% endfor %}
{% endif %}
{% if bind_records_a is defined %}
  {% for record in bind_records_a %}
    {% if record.host is defined %}
      {% set record_address = hostvars[record.host][bind_zone_address_var] | default('') %}
    {% else %}
      {% set record_address = record.ip | default('') %}
    {% endif %}
    {% if record_address %}
      {{- '%-40s' | format(record.name) }}{% if record.ttl is defined %} {{ record.ttl }}{% endif %} IN      A         {{ record_address }}
    {% endif %}
  {% endfor %}
{% endif %}

; A records - from Ansible inventory (managed hosts)
{% for host in groups[bind_ansible_group] %}
  {% if (hostvars[host].host_fqdn is defined) and (hostvars[host][bind_zone_address_var] is defined) %}
    {% if hostvars[host][bind_zone_address_var] %}
      {{- '%-40s' | format(hostvars[host].host_pfqdn) }} IN      A         {{ hostvars[host][bind_zone_address_var] }}
    {% endif %}
  {% endif %}
{% endfor %}

; A records - from Ansible inventory (unmanaged devices)
{# Unmanaged devices are LAN-only: nothing gives a printer a Tailscale address.
   In the tailnet view they are therefore absent rather than published at an
   address that cannot be reached — NXDOMAIN fails fast, a dead 192.168.x hangs. #}
{% for host in groups[bind_unmanaged_group] %}
  {% if (hostvars[host].host_fqdn is defined) and (hostvars[host][bind_zone_address_var] is defined) %}
    {% if hostvars[host][bind_zone_address_var] %}
      {{- '%-40s' | format(hostvars[host].host_pfqdn) }} IN      A         {{ hostvars[host][bind_zone_address_var] }}
    {% endif %}
  {% endif %}
{% endfor %}

; A records - Tailscale addresses from Ansible inventory (managed hosts)
{# Always the Tailscale address, in every view: `ts.<host>` is how you ask for
   the tailnet path on purpose, from either side. #}
{% if bind_tailscale_records_enabled %}
  {% for host in groups[bind_ansible_group] %}
    {% if (hostvars[host].host_pfqdn is defined) and (hostvars[host].host_tailscale_ipv4 is defined) %}
      {% if hostvars[host].host_tailscale_ipv4 %}
        {{- '%-40s' | format(bind_tailscale_record_prefix + '.' + hostvars[host].host_pfqdn) }} IN      A         {{ hostvars[host].host_tailscale_ipv4 }}
      {% endif %}
    {% endif %}
  {% endfor %}
{% endif %}

; cnames - from Ansible inventory
{# Identical in every view. This is what makes split horizon work: the name
   points at a host, and the host's A record is what changes per view. #}
{% for host in groups[bind_ansible_group] %}
  {% if hostvars[host].cnames is defined %}
    {% for cname in hostvars[host].cnames %}
      {{- '%-40s' | format(cname + '.') }} IN      CNAME     {{ hostvars[host].host_pfqdn }}
    {% endfor %}
  {% endif %}
{% endfor %}
