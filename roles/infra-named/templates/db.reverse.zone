#jinja2: lstrip_blocks:True
$TTL {{ bind_default_ttl }}
$ORIGIN {{ bind_iprange_reversed }}.IN-ADDR.ARPA.
@                                        IN      SOA     {{ bind_records_nameservers[0].name }}.{{ bind_domain }}. admin.{{ domainname_infra }}. (
  1234567890 ; Serial
  604800 ; Refresh
  86400 ; Retry
  2419200 ; Expire
  604800 ; Negative Cache TTL
)

; Nameservers - from config
{% if bind_records_nameservers is defined %}
{% for record in bind_records_nameservers %}
                                         IN      NS       {{ record.name }}.{{ bind_domain }}.
{% endfor %}
{% endif %}

; ---------------------------------------------------------------------------
; PTR records
;
; ONE PTR per address, naming the canonical host that owns it. Alias names
; (nameserver labels, apex/www A records, cnames_additional, and the
; composition cnames from dns_records_derived) are deliberately NOT emitted
; here, even though they all resolve forward to a host's IP.
;
; They used to be. The result was 52 PTRs on server-64gb-storage's address,
; and BIND rotates a multi-record RRset per query (default cyclic
; rrset-order), so any reverse lookup returned an arbitrary service name -
; `prowlarr.ewwww.eu.` one second, `www.ewwww.eu.` the next. Anything doing
; reverse lookups (WatchYourLAN, logs, sshd) got a coin flip instead of the
; host. Forward CNAMEs are unaffected; they stay in db.zone.
; ---------------------------------------------------------------------------

; PTR records - from Ansible inventory (managed hosts)
{% for host in groups[bind_ansible_group] %}
  {% if hostvars[host].host_fqdn is defined and hostvars[host].host_ipv4 is defined %}
    {% if hostvars[host].host_ipv4 %}
      {% set record_ip_split = hostvars[host].host_ipv4.split('.')[0:4] -%}
      {{- '%-40s' | format(record_ip_split[3] + '.' + record_ip_split[2])  }} IN      PTR      {{ hostvars[host].host_pfqdn }}.{{ bind_domain}}.
    {% endif %}
  {% endif %}
{% endfor %}

; PTR records - from Ansible inventory (unmanaged devices)
{% for host in groups[bind_unmanaged_group] %}
  {% if hostvars[host].host_fqdn is defined and hostvars[host].host_ipv4 is defined %}
    {% if hostvars[host].host_ipv4 %}
      {% set record_ip_split = hostvars[host].host_ipv4.split('.')[0:4] -%}
      {{- '%-40s' | format(record_ip_split[3] + '.' + record_ip_split[2])  }} IN      PTR      {{ hostvars[host].host_pfqdn }}.{{ bind_domain}}.
    {% endif %}
  {% endif %}
{% endfor %}
