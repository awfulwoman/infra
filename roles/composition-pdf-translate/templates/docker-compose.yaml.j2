# code: language=ansible-jinja
name: "{{ composition_name }}"
services:
  pdf-translate:
    container_name: pdf-translate
    image: ghcr.io/jctots/pdf-translate:0.2.1
    restart: unless-stopped
    env_file: .environment_vars
    # Upstream hard-codes a 30 s timeout per Ollama call (config.TRANSLATE_TIMEOUT,
    # no env var). Long text blocks on Malcolm can take longer, so patch the
    # constant before the backends import it.
    command:
      - python
      - -c
      - "import config, runpy; config.TRANSLATE_TIMEOUT = {{ composition_pdf_translate_block_timeout }}; runpy.run_path('app.py', run_name='__main__')"
    volumes:
      - "{{ composition_config }}/data:/app/data"
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.pdf-translate.rule=Host(`{{ composition_dns_subdomains[0] }}.{{ domainname_infra }}`)"
      - "traefik.http.routers.pdf-translate.tls=true"
{% if reverseproxy_use_letsencrypt and not reverseproxy_wildcard_cert %}
      - "traefik.http.routers.pdf-translate.tls.certresolver=letsencrypt"
{% endif %}
      - "traefik.http.services.pdf-translate.loadbalancer.server.port=7860"
    networks:
      - "{{ default_docker_network }}"
    healthcheck:
      test: ["CMD-SHELL", "bash -c 'echo > /dev/tcp/127.0.0.1/7860'"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s

networks:
  "{{ default_docker_network }}":
    external: true
