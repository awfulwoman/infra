defaults
auth on
tls  on
tls_trust_file /etc/ssl/certs/ca-certificates.crt
logfile /var/log/msmtp.log

# Gmail configuration
account mbox
host    smtp.{{ mail_account_personal.domain }}
port    587
from    {{ mail_account_personal.username }}
user    {{ mail_account_personal.username }}
password {{ mail_account_personal.password }}

account default: mbox
