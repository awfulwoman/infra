# code: language=ansible-jinja
name: "{{ composition_name }}"
services:
  guinea-pig-weights:
    container_name: guinea-pig-weights
    image: "{{ composition_guinea_pig_weights_image }}"
    restart: unless-stopped
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.guinea-pig-weights.rule=Host(`guineapigs.{{ domainname_infra }}`)"
      - "traefik.http.routers.guinea-pig-weights.tls=true"
{% if reverseproxy_use_letsencrypt and not reverseproxy_wildcard_cert %}
      - "traefik.http.routers.guinea-pig-weights.tls.certresolver=letsencrypt"
{% endif %}
      - "traefik.http.services.guinea-pig-weights.loadbalancer.server.port=8080"
    networks:
      - "{{ default_docker_network }}"
    healthcheck:
      test: ["CMD-SHELL", "wget -q --spider http://127.0.0.1:8080/ || exit 1"]
      interval: 60s
      timeout: 10s
      retries: 3
      start_period: 10s

networks:
  "{{ default_docker_network }}":
    external: true
