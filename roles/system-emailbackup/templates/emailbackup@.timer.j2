[Unit]
Description=Email Backup Sync Timer (%i)
Requires=emailbackup@%i.service

[Timer]
{% if emailbackup_sync_schedule == "hourly" %}
OnCalendar=hourly
{% elif emailbackup_sync_schedule == "weekly" %}
OnCalendar=weekly
{% else %}
OnCalendar=daily
{% endif %}
RandomizedDelaySec=300
Persistent=true

[Install]
WantedBy=timers.target
