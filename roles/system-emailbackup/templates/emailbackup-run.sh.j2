#!/bin/bash
# Managed by Ansible - do not edit manually (roles/system-emailbackup)
#
# Runs mbsync for the "{{ item.name }}" account and pings Healthchecks.io with an
# explicit success/fail signal — not just silence — so a failing account is
# reported immediately rather than only after a missed-check grace period.
set -o pipefail

/usr/bin/mbsync -c /home/{{ ansible_user }}/.mbsyncrc -V {{ item.name }}
EXIT=$?
{% if emailbackup_healthchecksio_enabled and emailbackup_hc_uuids is defined and emailbackup_hc_uuids[item.name] is defined %}
if [ $EXIT -eq 0 ]; then
  curl -fsS --retry 3 --max-time 10 "https://hc-ping.com/{{ emailbackup_hc_uuids[item.name] }}"
else
  curl -fsS --retry 3 --max-time 10 "https://hc-ping.com/{{ emailbackup_hc_uuids[item.name] }}/fail"
fi
{% endif %}
exit $EXIT
