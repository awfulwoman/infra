# code: language=ansible-jinja
name: "{{ composition_name }}"
services:
  webmention-server:
    container_name: webmention-server
    image: "{{ composition_webmention_server_image }}"
    restart: unless-stopped
    read_only: true
    tmpfs:
      - /tmp
    env_file: .environment_vars
    volumes:
      - "{{ composition_config }}/config.yaml:/config/config.yaml:ro"
      - "{{ composition_config }}/data:/data"
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.webmention-server.rule=Host(`{{ composition_webmention_server_hostname }}`)"
      - "traefik.http.routers.webmention-server.tls=true"
{% if reverseproxy_use_letsencrypt and not reverseproxy_wildcard_cert %}
      - "traefik.http.routers.webmention-server.tls.certresolver=letsencrypt"
{% endif %}
      - "traefik.http.services.webmention-server.loadbalancer.server.port=8000"
    networks:
      - "{{ default_docker_network }}"
    # The image defines its own HEALTHCHECK (GET /health), so none is repeated here.

networks:
  "{{ default_docker_network }}":
    external: true
