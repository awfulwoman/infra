# code: language=ansible
# Managed by Ansible (roles/composition-hermes-agent). Edits made here or by
# `hermes setup` inside the container are overwritten on the next play. Change
# the role variables instead, or set composition_hermes_agent_manage_config to
# false to hand the file back to Hermes.
#
# This is rendered once per managed profile: data/config.yaml for the built-in
# "default" profile, and data/profiles/<name>/config.yaml for a named one
# (composition_hermes_agent_profile). Profile configs are standalone, not merged
# over the base file.
#
# config.yaml is the source of truth for model, provider and endpoint. Secrets
# stay out of it: they arrive as environment variables from .environment_vars,
# which takes precedence over /opt/data/.env. mcp_servers headers reference
# ${ENVVAR} placeholders that Hermes interpolates from the process environment.

# Schema version this file is written against. Without it Hermes treats the
# config as predating version 12 and refuses to migrate it. Read the value the
# image actually expects, rather than the one the warning text names:
#
#   docker exec hermes /opt/hermes/.venv/bin/python -c \
#     'from hermes_cli.config import DEFAULT_CONFIG; print(DEFAULT_CONFIG["_config_version"])'
#
# Re-check it after bumping composition_hermes_agent_image.
_config_version: {{ composition_hermes_agent_config_version }}

model:
  default: "{{ composition_hermes_agent_model }}"
  provider: custom
  base_url: "{{ composition_hermes_agent_base_url }}"
  api_key: "{{ composition_hermes_agent_api_key }}"
  context_length: {{ composition_hermes_agent_context_length }}

terminal:
  backend: "{{ composition_hermes_agent_terminal_backend }}"

# Each profile's gateway runs its own OpenAI-API server; distinct ports keep
# them from clashing on startup (composition_hermes_agent_api_server_port + the
# profile's position, or a per-profile api_server_port override).
platforms:
  api_server:
    port: {{ _hermes_api_port }}
{% if composition_hermes_agent_dashboard_theme or composition_hermes_agent_dashboard_font %}

dashboard:
{% if composition_hermes_agent_dashboard_theme %}
  theme: {{ composition_hermes_agent_dashboard_theme }}
{% endif %}
{% if composition_hermes_agent_dashboard_font %}
  font: {{ composition_hermes_agent_dashboard_font }}
{% endif %}
{% endif %}
{% if _hermes_disabled_toolsets | default([]) | length > 0 %}

# Toolsets this profile may not use. agent.disabled_toolsets is a global
# suppression list applied last - toolset granularity only (Hermes silently
# ignores individual tool names here), so e.g. "browser" removes every
# browser_* tool.
agent:
  disabled_toolsets:
{% for _ts in _hermes_disabled_toolsets %}
    - {{ _ts }}
{% endfor %}
{% endif %}
{% if _hermes_mcp_servers | default({}) | length > 0 %}

# MCP servers for this profile. Bearer tokens are not written here - the
# ${ENVVAR} placeholders resolve from .environment_vars (see
# composition_hermes_agent_mcp_env).
{{ {'mcp_servers': _hermes_mcp_servers} | to_nice_yaml(indent=2) }}
{%- endif %}
