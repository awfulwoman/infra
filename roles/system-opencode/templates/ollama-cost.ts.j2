// Managed by Ansible (system-opencode). Local edits are overwritten.
//
// Overlays Ollama Cloud prices onto the discovered model catalog. The
// catalogue service scrapes ollama.com daily and serves opencode's own model
// shape: `cost` in USD per million tokens, and the `$` usage tier in the
// display name. Models stay discovery-driven; only those two fields are set.
import type { Plugin } from "@opencode-ai/plugin";

const CATALOGUE_URL = "{{ system_opencode_ollama_pricing_url }}/v1/opencode";
const REFRESH_MS = 24 * 60 * 60 * 1000;
// A failed fetch is usually transient (service still starting, DNS not yet
// answering), so retry soon rather than leaving the catalog unpriced for a day.
const RETRY_MS = 5 * 60 * 1000;
const TIMEOUT_MS = 10_000;

type Cost = { input: number; output: number; cache: { read: number; write: number } };
type ModelEntry = { name?: string; cost?: Cost[] };
type Payload = { providers?: { ollama?: { models?: Record<string, ModelEntry> } } };

async function fetchCatalogue(): Promise<Record<string, ModelEntry>> {
  try {
    const response = await fetch(CATALOGUE_URL, { signal: AbortSignal.timeout(TIMEOUT_MS) });
    if (!response.ok) return {};
    const payload = (await response.json()) as Payload;
    return payload.providers?.ollama?.models ?? {};
  } catch {
    // The service being down must not break startup: prices and names are
    // cosmetic, and the models keep working without them.
    return {};
  }
}

const plugin: Plugin = {
  id: "ollama-cost",
  async setup(ctx) {
    let entries = await fetchCatalogue();

    const apply = async () => {
      await ctx.model.transform((editor) => {
        // Every rebuild replays this transform, so a discovery refresh cannot
        // drop the prices again.
        for (const model of editor.list("ollama")) {
          const entry = entries[model.id];
          if (!entry) continue;
          editor.update("ollama", model.id, (draft) => {
            if (entry.name) draft.name = entry.name;
            if (entry.cost) draft.cost = entry.cost;
          });
        }
      });
    };

    await apply();

    let timer: ReturnType<typeof setTimeout>;

    function schedule(delay: number) {
      timer = setTimeout(() => void refresh(), delay);
    }

    async function refresh() {
      try {
        const next = await fetchCatalogue();
        const found = Object.keys(next).length > 0;
        // Keep the last good scrape when the service is unreachable.
        if (found) entries = next;
        await apply();
        await ctx.model.reload();
        schedule(found ? REFRESH_MS : RETRY_MS);
      } catch {
        schedule(RETRY_MS);
      }
    }

    schedule(REFRESH_MS);

    return () => clearTimeout(timer);
  },
};

export default plugin;
