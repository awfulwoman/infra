#!/usr/bin/env bash
# Managed by Ansible (system-opencode). Local edits are overwritten.
#
# Mints a 1-hour GitHub App installation token and prints it to stdout.
# Signs a short-lived JWT with the vaulted App private key, then asks GitHub
# for an installation access token. Run outside the nono sandbox (by the
# opencode wrapper and the git credential helper); the agent never invokes
# this directly and can never read the App key itself.
set -euo pipefail

APP_ID={{ system_opencode_github_app_id | quote }}
INSTALLATION_ID={{ system_opencode_github_installation_id | quote }}
KEY_FILE={{ system_opencode_github_app_key_file | quote }}

# Portable base64url (works on GNU openssl and macOS LibreSSL): strip
# newlines and padding, then translate the two URL-unsafe characters.
base64url() { openssl base64 | tr -d '\n=' | tr '+/' '-_'; }

now=$(date +%s)
header=$(printf '{"alg":"RS256","typ":"JWT"}' | base64url)
payload=$(printf '{"iat":%d,"exp":%d,"iss":"%s"}' "$now" "$((now + 60))" "$APP_ID" | base64url)
signed=$(printf '%s.%s' "$header" "$payload" | openssl dgst -sha256 -sign "$KEY_FILE" -binary | base64url)
jwt="$header.$payload.$signed"

curl -fsS \
  -X POST \
  -H "Authorization: Bearer $jwt" \
  -H "Accept: application/vnd.github+json" \
  -H "X-GitHub-Api-Version: 2022-11-28" \
  "https://api.github.com/app/installations/$INSTALLATION_ID/access_tokens" \
  | python3 -c 'import sys, json; print(json.load(sys.stdin)["token"])'
