#!/usr/bin/env bash
# Managed by Ansible (system-opencode). Local edits are overwritten.
#
# Runs opencode inside a nono sandbox. opencode v2 normally hands work to a
# background server that nono cannot contain, so interactive use is forced to
# --standalone (a private server inside the sandbox).
#
# This is a convenience, not enforcement: running the real binary directly
# ({{ system_opencode_binary }}) is not sandboxed.
set -euo pipefail

real={{ system_opencode_binary | quote }}

{% if system_opencode_agentmemory %}
# agentmemory URL and secret (0600 file written by Ansible), for the MCP shim
# and the capture plugin.
if [ -r {{ system_opencode_agentmemory_env_file | quote }} ]; then
  set -a
  . {{ system_opencode_agentmemory_env_file | quote }}
  set +a
fi

{% endif %}
{% if system_opencode_gateway %}
# Gateway MCP token (0600 file written by Ansible).
if [ -r {{ system_opencode_gateway_env_file | quote }} ]; then
  set -a
  . {{ system_opencode_gateway_env_file | quote }}
  set +a
fi

{% endif %}
{% if system_opencode_searxng %}
# SearXNG MCP token (0600 file written by Ansible).
if [ -r {{ system_opencode_searxng_env_file | quote }} ]; then
  set -a
  . {{ system_opencode_searxng_env_file | quote }}
  set +a
fi

{% endif %}
{% if system_opencode_ha_mcp %}
# Home Assistant MCP URL, secret path included (0600 file written by Ansible).
if [ -r {{ system_opencode_ha_mcp_env_file | quote }} ]; then
  set -a
  . {{ system_opencode_ha_mcp_env_file | quote }}
  set +a
fi

{% endif %}
{% if system_opencode_github %}
# GitHub: a short-lived installation token for git and gh. The App key is denied
# to the sandbox, so only the wrapper (outside it) can mint. A running session
# cannot have its environment refreshed, so the token lives in a file that the
# credential helper and the gh shim read; GH_TOKEN below is only the starting
# value, and the refresher keeps the file ahead of the hour.
export OPENCODE_GITHUB_TOKEN_FILE={{ system_opencode_github_token_file | quote }}

# Mint to a temporary file in the same directory and move it into place, so a
# reader never sees a partial token.
mint_github_token() {
  local tmp
  tmp=$(mktemp {{ system_opencode_config_dir | quote }}/.gh-token.XXXXXX) || return 1
  if ! {{ system_opencode_github_mint_helper | quote }} >"$tmp" 2>/dev/null; then
    rm -f "$tmp"
    return 1
  fi
  chmod 0600 "$tmp"
  mv -f "$tmp" {{ system_opencode_github_token_file | quote }}
}

if ! mint_github_token; then
  printf 'opencode: could not mint a GitHub token; git push and gh will fail\n' >&2
fi
export GH_TOKEN="$(cat {{ system_opencode_github_token_file | quote }} 2>/dev/null || true)"
export GITHUB_TOKEN="$GH_TOKEN"
# Session-local, so the shim wins over Homebrew's gh without touching the
# user's PATH or their own gh login.
export PATH={{ system_opencode_github_shim_dir | quote }}:"$PATH"

# Refresh for the life of the session. $$ stays this process across the exec
# below, so the loop ends when the session does and never mints while nothing
# is running. Start time plus command name identify the session, so a recycled
# PID (another session starting as this one ends) cannot keep the loop alive.
session_pid=$$
session_start=$(ps -o lstart= -p "$session_pid" 2>/dev/null || true)
session_alive() {
  kill -0 "$session_pid" 2>/dev/null || return 1
  [ -n "$session_start" ] || return 1
  [ "$(ps -o lstart= -p "$session_pid" 2>/dev/null || true)" = "$session_start" ] || return 1
  case "$(ps -o comm= -p "$session_pid" 2>/dev/null || true)" in
    *opencode* | *nono*) return 0 ;;
  esac
  return 1
}
(
  while sleep {{ system_opencode_github_token_refresh_seconds }}; do
    session_alive || break
    mint_github_token || true
  done
) &

# Point gh at a sandbox-local config dir so it never reads
# ~/.config/gh/hosts.yml (the long-lived OAuth token). gh creates its minimal
# config here and authenticates with the token above.
export GH_CONFIG_DIR={{ system_opencode_gh_config_dir | quote }}
export GIT_CONFIG_COUNT=2
export GIT_CONFIG_KEY_0="url.https://x-access-token@github.com/.insteadOf"
export GIT_CONFIG_VALUE_0="git@github.com:"
export GIT_CONFIG_KEY_1="credential.helper"
export GIT_CONFIG_VALUE_1="!{{ system_opencode_github_credential_helper }}"

{% endif %}
# CLI settings owned by Ansible; merged over the TUI-managed cli.json.
export OPENCODE_CLI_CONFIG_CONTENT={{ system_opencode_cli_config | to_json | quote }}

{% if system_opencode_serve %}
# Remote server: the server owns tool execution, so it runs inside nono.
# --listen-port lets the sandboxed process bind the API port. The Basic-auth
# password comes from a 0600 file outside the sandbox's grants and reaches the
# server through the environment. --allow-cwd is needed without a terminal.
if [ "${1:-}" = serve ]; then
  if [ -r {{ system_opencode_serve_env_file | quote }} ]; then
    set -a
    . {{ system_opencode_serve_env_file | quote }}
    set +a
  fi
  shift
  exec {{ system_opencode_nono_binary | quote }} run \
    --profile {{ system_opencode_nono_profile | quote }} \
    --allow-cwd \
    --listen-port {{ system_opencode_serve_port }} \
    -- "$real" serve "$@"
fi

{% endif %}
case "${1:-}" in
  # Administrative commands: no --standalone support, run unsandboxed.
  serve|auth|acp|service|upgrade|update|uninstall|models|stats|session|plugin|mcp|debug|api|--help|-h|--version|-v)
    exec "$real" "$@"
    ;;
esac

exec {{ system_opencode_nono_binary | quote }} run \
  --profile {{ system_opencode_nono_profile | quote }} \
  -- "$real" --standalone "$@"
