#!/usr/bin/env bash
# Managed by Ansible (system-opencode). Local edits are overwritten.
#
# git credential helper for github.com. Answers "get" with the installation
# token already minted by the wrapper (GH_TOKEN in the environment). It cannot
# mint a fresh token here: the App private key is denied to the sandbox, so a
# subprocess of opencode cannot read it. The username is supplied by the URL
# rewrite (x-access-token@) set by the wrapper.
set -euo pipefail

if [ "${1:-}" != "get" ]; then
  exit 0
fi

printf 'username=x-access-token\npassword=%s\n' "${GH_TOKEN:-}"
