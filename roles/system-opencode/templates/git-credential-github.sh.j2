#!/usr/bin/env bash
# Managed by Ansible (system-opencode). Local edits are overwritten.
#
# git credential helper for github.com. On a "get" request it answers with a
# freshly minted installation token, so every push authenticates with a
# short-lived token rather than a stored key. The username is supplied by the
# URL rewrite (x-access-token@) in the wrapper's git config.
set -euo pipefail

if [ "${1:-}" != "get" ]; then
  exit 0
fi

printf 'username=x-access-token\npassword=%s\n' "$({{ system_opencode_github_mint_helper | quote }})"
