#!/usr/bin/env bash
# Managed by Ansible (system-opencode). Local edits are overwritten.
#
# git credential helper for github.com. Answers "get" with the installation
# token the wrapper's refresher keeps in OPENCODE_GITHUB_TOKEN_FILE. The file,
# not GH_TOKEN, is read: the token outlives the environment it started in, and
# a running session cannot have its variables updated.
#
# It cannot mint here: the App private key is denied to the sandbox, so a
# subprocess of opencode cannot read it. The username comes from the URL
# rewrite (x-access-token@) the wrapper sets.
set -euo pipefail

if [ "${1:-}" != "get" ]; then
  exit 0
fi

token=${GH_TOKEN:-}
if [ -n "${OPENCODE_GITHUB_TOKEN_FILE:-}" ] && [ -r "$OPENCODE_GITHUB_TOKEN_FILE" ]; then
  token=$(<"$OPENCODE_GITHUB_TOKEN_FILE")
fi

printf 'username=x-access-token\npassword=%s\n' "$token"
