// Managed by Ansible (system-opencode). Local edits are overwritten.
// opencode v2 native format: https://v2.opencode.ai/config
{
  "$schema": "https://opencode.ai/config.json",
{% if system_opencode_model %}
  "model": {{ system_opencode_model | to_json }},
{% endif %}
  // The last matching rule wins: defaults first, then the allow-list, then extras.
  "permissions": [
{% for rule in system_opencode_permissions_default %}
    {{ rule | to_json }},
{% endfor %}
{% for cmd in system_opencode_shell_allow %}
    {{ {"action": "shell", "resource": cmd, "effect": "allow"} | to_json }},
{% endfor %}
{% for rule in system_opencode_permissions_extra %}
    {{ rule | to_json }},
{% endfor %}
  ],
{% if system_opencode_agentmemory or system_opencode_gateway %}
  "mcp": {
    "servers": {
{% endif %}
{% if system_opencode_agentmemory %}
      // Memory tools. The shim proxies to the agentmemory server named by
      // AGENTMEMORY_URL (all tools) and falls back to 7 local ones without it.
      "agentmemory": {
        "type": "local",
        // Expose the tools directly. v2's default Code Mode hides them behind
        // an `execute` tool, which smaller models do not call reliably.
        "codemode": false,
        // Installed globally by Ansible: npx cannot create its cache inside the
        // nono sandbox, so the shim is run directly.
        "command": ["bash", "-c", ". \"$HOME/.nvm/nvm.sh\" && exec agentmemory-mcp"],
        "environment": {
          "AGENTMEMORY_URL": {{ system_opencode_agentmemory_url | to_json }},
          "AGENTMEMORY_SECRET": "{env:AGENTMEMORY_SECRET}",
        },
      },
{% endif %}
{% if system_opencode_gateway %}
      // Personal services (email, calendar, notes, bookmarks, reminders). The
      // token is this client's own, read from the environment so it never
      // lands in this file; the wrapper exports it from a 0600 file.
      "gateway": {
        "type": "remote",
        "url": {{ system_opencode_gateway_url | to_json }},
        "headers": {
          "Authorization": "Bearer {env:GATEWAY_MCP_TOKEN}",
        },
        "codemode": false,
      },
{% endif %}
{% if system_opencode_agentmemory or system_opencode_gateway %}
    },
  },
{% endif %}
{% if system_opencode_plugins %}
  "plugins": {{ system_opencode_plugins | to_json }},
{% endif %}
  "providers": {
    // v2 discovers Ollama models and reads their context size, vision and
    // tool support from Ollama, so models are not listed here.
    "ollama": {
      "settings": {
        "baseURL": {{ system_opencode_ollama_base_url | to_json }},
        // Placeholder so opencode-quota's custom provider finds a key for "ollama".
        "apiKey": {{ system_opencode_ollama_placeholder_key | to_json }},
      },
    },
  },
{% if system_opencode_policies %}
  "policies": [
{% for p in system_opencode_policies %}
    {{ p | to_json }},
{% endfor %}
  ],
{% endif %}
}
