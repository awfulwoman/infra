# code: language=ansible
name: "{{ composition_name }}"
services:
  op-connect-api:
    cap_add:
      - NET_BROADCAST
    image: 1password/connect-api:latest
    restart: unless-stopped
    volumes:
      - "{{ composition_config }}/1password-credentials.json:/home/opuser/.op/1password-credentials.json:ro"
{% if onepassword_connect_data_bind_mount %}
      - "{{ composition_config }}/data:/home/opuser/.op/data"
{% else %}
      - "op-connect-data:/home/opuser/.op/data"
{% endif %}
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.op-connect.rule=Host(`{{ composition_dns_subdomains[0] }}.{{ domainname_infra }}`)"
      - "traefik.http.routers.op-connect.tls=true"
{% if reverseproxy_use_letsencrypt and not reverseproxy_wildcard_cert %}
      - "traefik.http.routers.op-connect.tls.certresolver=letsencrypt"
{% endif %}
      - "traefik.http.services.op-connect.loadbalancer.server.port=8080"
    env_file: .environment_vars
    networks:
      - "{{ default_docker_network }}"

  op-connect-sync:
    cap_add:
      - NET_BROADCAST
    image: 1password/connect-sync:latest
    restart: unless-stopped
    env_file: .environment_vars
    networks:
      - "{{ default_docker_network }}"
    volumes:
      - "{{ composition_config }}/1password-credentials.json:/home/opuser/.op/1password-credentials.json:ro"
{% if onepassword_connect_data_bind_mount %}
      - "{{ composition_config }}/data:/home/opuser/.op/data"
{% else %}
      - "op-connect-data:/home/opuser/.op/data"
{% endif %}

{% if not onepassword_connect_data_bind_mount %}
volumes:
  op-connect-data:

{% endif %}
networks:
  "{{ default_docker_network }}":
    external: true
