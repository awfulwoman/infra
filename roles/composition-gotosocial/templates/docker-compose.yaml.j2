# code: language=ansible
name: "{{ composition_name }}"
services:
  gotosocial:
    image: superseriousbusiness/gotosocial:0.22.2
    container_name: gotosocial
    restart: unless-stopped
    env_file: .environment_vars
    user: 1000:1000
    ports:
      - "8085:8080"
    labels:
      - "traefik.enable=true"
    volumes:
      - "{{ composition_config }}/config.yaml:/gotosocial/config.yaml"
      - "{{ composition_config }}/db:/gotosocial/db"
      # Remote media cache and compile cache live on the VM disk. They are
      # rebuildable, so they stay off the block storage. Only the two local
      # accounts' media folders are mounted over it from the volume.
      - gotosocial-media:/gotosocial/storage
      - "{{ composition_root }}/media/{{ gotosocial_local_account_id }}:/gotosocial/storage/{{ gotosocial_local_account_id }}"
      - "{{ composition_root }}/media/{{ gotosocial_instance_account_id }}:/gotosocial/storage/{{ gotosocial_instance_account_id }}"
      - gotosocial-cache:/gotosocial/.cache
      - /etc/localtime:/etc/localtime:ro
    networks:
      - "{{ default_docker_network }}"
    healthcheck:
      test: ["CMD", "wget", "--no-verbose", "--tries=1", "--spider", "http://127.0.0.1:8080/api/v1/instance"]
      interval: 1m
      timeout: 10s
      retries: 3
      start_period: 30s

volumes:
  gotosocial-media:
    name: gotosocial-media
  gotosocial-cache:
    name: gotosocial-cache

networks:
  "{{ default_docker_network }}":
    external: true
