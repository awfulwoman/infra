# Pinned to 3.12 on purpose: kagimcp 1.0.0 declares `Requires-Python ==3.12.*`,
# and 1.1.0 drags in pydantic-core, which has no cp315 wheels. Renovate bumped
# this to 3.15 twice (#308, #321) and broke the build both times, so renovate.json
# ignores this file. See cd9e2d12.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

RUN pip install kagimcp=={{ composition_mcp_kagisearch_version }}

ENV PORT=8000
EXPOSE 8000

CMD ["sh", "-c", "kagimcp --http --host 0.0.0.0 --port ${PORT}"]
