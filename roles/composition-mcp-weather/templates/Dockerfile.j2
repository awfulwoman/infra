FROM python:3.14-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# nodejs/npm to run the upstream weather-mcp package via npx - it only
# speaks MCP over stdio, so mcp-proxy bridges it to Streamable HTTP.
RUN apt-get update \
    && apt-get install -y --no-install-recommends nodejs npm \
    && rm -rf /var/lib/apt/lists/*

# mcp-proxy 0.12.0 declares an unbounded "mcp>=1.17.0" dependency, which
# resolves to mcp 2.0.0 and crashes on import (removed request_ctx symbol -
# see github.com/sparfenyuk/mcp-proxy/issues/235, fix not yet released).
# Pin mcp explicitly until that's fixed upstream.
RUN pip install "mcp-proxy=={{ composition_mcp_weather_proxy_version }}" "mcp=={{ composition_mcp_weather_mcp_sdk_version }}"

ENV PORT={{ composition_mcp_weather_port }}
EXPOSE {{ composition_mcp_weather_port }}

CMD ["sh", "-c", "mcp-proxy --port ${PORT} --host 0.0.0.0 --pass-environment -- npx -y @dangahagan/weather-mcp@{{ composition_mcp_weather_package_version }}"]
