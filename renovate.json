{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": [
        "config:recommended"
    ],
    "dependencyDashboard": true,
    "dependencyDashboardTitle": "Renovate Dashboard",
    "labels": [
        "renovatebot"
    ],
    "docker-compose": {
        "managerFilePatterns": [
            "/docker-compose.yaml/",
            "/docker-compose.yaml.j2/"
        ]
    },
    "packageRules": [
        {
            "description": "GoToSocial patch releases merge themselves. Minor and major stay as PRs: they have needed config changes, and database migrations only go forward.",
            "matchPackageNames": [
                "superseriousbusiness/gotosocial"
            ],
            "matchUpdateTypes": [
                "patch"
            ],
            "automerge": true
        }
    ]
}
